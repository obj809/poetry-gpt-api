# Copy to .env and fill in real values:  cp .env.example .env

# LiteLLM virtual key (created in the LiteLLM admin UI). On the VPS this routes
# through the proxy, so use the virtual key here — NOT a real OpenAI key.
OPENAI_API_KEY=sk-your-litellm-virtual-key

# Model name; must be defined in LiteLLM's config.yaml.
OPENAI_MODEL=gpt-5.4-nano

# Upstream endpoint. On the VPS the litellm container is reachable by name over
# the shared webnet network. For host dev without the proxy, use OpenAI directly:
#   OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=http://litellm:4000/v1

# Comma-separated allowlist of exact browser origins. Empty = no browser origins
# allowed (curl / server-to-server still works). Add your frontend origin(s).
CORS_ORIGIN=
